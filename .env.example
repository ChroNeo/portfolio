# Base URL of the Strapi CMS the site is built from.
#
# Local:     http://localhost:1337
# Deployed:  the public tunnel host of the machine running Strapi, e.g.
#            https://cms.example.com  (Cloudflare Tunnel)
#            https://<name>.ngrok-free.app  (ngrok static domain)
# The build fetches projects from it, so it has to be reachable from Vercel.
STRAPI_URL=http://localhost:1337
