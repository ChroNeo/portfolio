---
interface Props {
  title: string;
}
const { title } = Astro.props;
import "../styles/global.css";
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 overflow-x-hidden">
    <slot />
  </body>
</html>

<style>
  @reference "../styles/global.css";
</style>