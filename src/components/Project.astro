---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { 
  SiReact, 
  SiTypescript, 
  SiJavascript, 
  SiFastify, 
  SiNodedotjs, 
  SiMysql, 
  SiDocker, 
  SiLinux, 
  SiGooglecloud, 
  SiSocketdotio, 
  SiRedis, 
  SiPostgresql 
} from 'react-icons/si';
import { FaAws, FaLine } from 'react-icons/fa6';

const projects = await getCollection("projects");

// Manual rotation/tape variety per card index, cycles through 3 looks
const cardStyles = [
  { rotate: "-rotate-[1.5deg]", tape: "-rotate-3" },
  { rotate: "rotate-[1.5deg]", tape: "rotate-3" },
  { rotate: "-rotate-[0.8deg]", tape: "-rotate-2" },
];

// Icon mapping for common tech
const getTechIcon = (tech: string) => {
  const icons: Record<string, any> = {
    'React': SiReact,
    'TypeScript': SiTypescript,
    'JavaScript': SiJavascript,
    'Fastify': SiFastify,
    'Node.js': SiNodedotjs,
    'MySQL': SiMysql,
    'Docker': SiDocker,
    'Linux': SiLinux,
    'AWS': FaAws,
    'GCP': SiGooglecloud,
    'Socket.io': SiSocketdotio,
    'Redis': SiRedis,
    'PostgreSQL': SiPostgresql,
    'LINE': FaLine,
    'LINE Messaging API': FaLine,
  };
  return icons[tech] || SiJavascript;
};
---

<section id="projects" class="paper-bg px-8 py-20">
  <p class="text-4xl font-bold text-black mb-4">PROJECTS</p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      projects.map((project, i) => {
        const style = cardStyles[i % cardStyles.length];
        return (
          <div class="cut-2 relative drop-shadow-md">
            <a
              href={`/projects/${project.id}`}
              class={`block bg-amber-50 border border-amber-200 shadow-md p-4 hover:rotate-0 transition-transform duration-200`}
            >
              <div class="w-full h-40 rounded-lg bg-amber-100 mb-2 flex items-center justify-center text-amber-700/60 text-xs overflow-hidden ${style.rotate}">
                {project.data.thumbnail ? (
                  <Image
                    src={project.data.thumbnail}
                    alt={project.data.title}
                    width={300}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  "thumbnail"
                )}
              </div>
              <h3 class="font-caveat text-lg font-semibold text-stone-800 mb-1">
                {project.data.title}
              </h3>
              <p class="text-stone-600 text-sm mb-2 leading-snug">
                {project.data.description}
              </p>
              <div class="flex flex-wrap gap-2 mb-2">
                {project.data.stack.map((tech) => {
                  const Icon = getTechIcon(tech);
                  return (
                    <span class="inline-flex items-center gap-1 text-stone-500 text-xs bg-amber-100/50 px-2 py-1 rounded">
                      <Icon size={12} />
                      <span>{tech}</span>
                    </span>
                  );
                })}
              </div>
              <span class="text-amber-700 text-sm underline">
                View details →
              </span>
            </a>
          </div>
        );
      })
    }
  </div>

  <p class="text-stone-500 text-sm mt-3 px-0.5">
    Also working with: Docker · Linux · Cloud (AWS/GCP)
  </p>
</section>
