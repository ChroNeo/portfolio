---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { 
  SiReact, 
  SiTypescript, 
  SiJavascript, 
  SiFastify, 
  SiNodedotjs, 
  SiMysql, 
  SiDocker, 
  SiLinux, 
  SiGooglecloud, 
  SiSocketdotio, 
  SiRedis, 
  SiPostgresql 
} from 'react-icons/si';
import { FaAws, FaLine } from 'react-icons/fa6';
import type { IconType } from "react-icons/lib";

const projects = await getCollection("projects");


// Icon mapping for common tech
const getTechIcon = (tech: string) => {
  const icons: Record<string, IconType> = {
    'React': SiReact,
    'TypeScript': SiTypescript,
    'JavaScript': SiJavascript,
    'Fastify': SiFastify,
    'Node.js': SiNodedotjs,
    'MySQL': SiMysql,
    'Docker': SiDocker,
    'Linux': SiLinux,
    'AWS': FaAws,
    'GCP': SiGooglecloud,
    'Socket.io': SiSocketdotio,
    'Redis': SiRedis,
    'PostgreSQL': SiPostgresql,
    'LINE': FaLine,
    'LINE Messaging API': FaLine,
  };
  return icons[tech] || SiJavascript;
};
---

<section id="projects" class="paper-bg px-8 py-20">
  <p class="mb-4 text-4xl font-bold text-black">PROJECTS</p>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      projects.map((project) => {
        return (
          <div class="cut-2 relative drop-shadow-md">
            <a
              href={`/portfolio/projects/${project.id}`}
              class={`block border border-amber-200 bg-amber-50 p-4 shadow-md transition-transform duration-200 hover:rotate-0`}
            >
              <div class="w-full h-40 rounded-lg bg-amber-100 mb-2 flex items-center justify-center text-amber-700/60 text-xs overflow-hidden ${style.rotate}">
                {project.data.thumbnail ? (
                  <Image
                    src={project.data.thumbnail}
                    alt={project.data.title}
                    width={300}
                    class="h-full w-full object-cover"
                  />
                ) : (
                  "thumbnail"
                )}
              </div>
              <h3 class="font-caveat mb-1 text-lg font-semibold text-stone-800">
                {project.data.title}
              </h3>
              <p class="mb-2 text-sm leading-snug text-stone-600">
                {project.data.description}
              </p>
              <div class="mb-2 flex flex-wrap gap-2">
                {project.data.stack.map((tech) => {
                  const Icon = getTechIcon(tech);
                  return (
                    <span class="inline-flex items-center gap-1 rounded bg-amber-100/50 px-2 py-1 text-xs text-stone-500">
                      <Icon size={12} />
                      <span>{tech}</span>
                    </span>
                  );
                })}
              </div>
              <span class="text-sm text-amber-700 underline">
                View details →
              </span>
            </a>
          </div>
        );
      })
    }
  </div>

  <p class="mt-3 px-0.5 text-sm text-stone-500">
    Also working with: Docker · Linux · Cloud (AWS/GCP)
  </p>
</section>
