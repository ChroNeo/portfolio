---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const projects = await getCollection("projects");

// Manual rotation/tape variety per card index, cycles through 3 looks
const cardStyles = [
  { rotate: "-rotate-[1.5deg]", tape: "-rotate-3" },
  { rotate: "rotate-[1.5deg]", tape: "rotate-3" },
  { rotate: "-rotate-[0.8deg]", tape: "-rotate-2" },
];
---

<section id="projects" class="paper-bg px-8 py-20">
  <p class="stamp text-xs text-amber-700/70 mb-4">SECTION 03 — PROJECTS</p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {
      projects.map((project, i) => {
        const style = cardStyles[i % cardStyles.length];
        return (
          <div class="cut-2 relative drop-shadow-md">
            <a
              href={`/projects/${project.id}`}
              class={`block bg-amber-50 border border-amber-200 shadow-md p-4 hover:rotate-0 transition-transform duration-200`}
            >
              <div class="w-full h-40 rounded-lg bg-amber-100 mb-2 flex items-center justify-center text-amber-700/60 text-xs overflow-hidden ${style.rotate}">
                {project.data.thumbnail ? (
                  <Image
                    src={project.data.thumbnail}
                    alt={project.data.title}
                    width={300}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  "thumbnail"
                )}
              </div>
              <h3 class="font-caveat text-lg font-semibold text-stone-800 mb-1">
                {project.data.title}
              </h3>
              <p class="text-stone-600 text-sm mb-2 leading-snug">
                {project.data.description}
              </p>
              <p class="text-stone-500 text-xs mb-2">
                {project.data.stack.join(" · ")}
              </p>
              <span class="text-amber-700 text-sm underline">
                View details →
              </span>
            </a>
          </div>
        );
      })
    }
  </div>

  <p class="text-stone-500 text-sm mt-3 px-0.5">
    Also working with: Docker · Linux · Cloud (AWS/GCP)
  </p>
</section>
