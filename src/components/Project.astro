---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { getTechIcon } from "../lib/techIcons";

const projects = await getCollection("projects");
---

<section id="projects" class="paper-bg px-8 py-20">
  <p class="mb-4 text-4xl font-bold text-(--ink)">PROJECTS</p>

  <div class="board">
    <div class="board-inner p-6 md:p-8">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          projects.map((project) => {
            return (
              <div class="project-card relative drop-shadow-md">
                <div class="pin -top-2 left-1/2 -translate-x-1/2" />
                <a
                  href={`/portfolio/projects/${project.id}`}
                  class={`block rounded-lg border border-(--paper-line) bg-(--card-bg) p-4 text-center shadow-md transition-transform duration-300 hover:scale-[1.03]`}
                >
                  <div class="mb-2 flex h-40 w-full items-center justify-center overflow-hidden rounded-lg bg-(--paper-line) text-xs text-(--ink-soft)/60">
                    {project.data.thumbnail ? (
                      <Image
                        src={project.data.thumbnail}
                        alt={project.data.title}
                        width={300}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    ) : (
                      "thumbnail"
                    )}
                  </div>
                  <h3 class="font-caveat mb-1 text-lg font-semibold text-(--ink)">
                    {project.data.title}
                  </h3>
                  {project.data.titleEn && (
                    <p class="font-caveat mb-1 text-sm text-(--ink)">
                      {project.data.titleEn}
                    </p>
                  )}
                  <p class="mb-3 text-sm leading-snug text-(--ink-soft)">
                    {project.data.description}
                  </p>
                  <div class="flex flex-wrap justify-center gap-1.5">
                    {project.data.stack.map((tech) => {
                      const Icon = getTechIcon(tech);
                      return (
                        <span class="tech-chip inline-flex items-center gap-1.5 rounded-md border border-(--paper-line) bg-(--paper-bg) px-3 py-1 text-sm text-(--ink)">
                          <Icon size={16} />
                          <span>{tech}</span>
                        </span>
                      );
                    })}
                  </div>
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>

  <p class="project-extra mt-3 px-0.5 text-sm text-(--ink-soft)">
    Also working with: Docker · Linux · Cloud (AWS/GCP)
  </p>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const label = document.querySelector("#projects > p");
  if (label && !reduceMotion) {
    gsap.from(label, {
      autoAlpha: 0,
      y: 40,
      duration: 0.7,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "#projects",
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
    });
  }

  if (!reduceMotion) {
    const swingAngle = (target: Element, max: number) => {
      const width = (target as HTMLElement).offsetWidth || 1;
      const scale = gsap.utils.clamp(0.35, 1, 90 / width);
      return max * scale;
    };

    gsap.utils
      .toArray<HTMLElement>("#projects .project-card")
      .forEach((card, i) => {
        const tilt = i % 2 === 0 ? 1 : -1;
        const rest = tilt * 0.5;
        const chips = card.querySelectorAll<HTMLElement>(".tech-chip");

        gsap.set(card, { transformOrigin: "50% 0%", rotation: rest });
        gsap.set(chips, { transformOrigin: "50% 0%" });

        const startIdle = () => {
          gsap.killTweensOf(card);
          gsap.to(card, {
            rotation: tilt * 1.3,
            duration: 1.4,
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
          });
        };

        const swing = () => {
          gsap.killTweensOf([card, chips]);
          gsap.fromTo(
            card,
            { rotation: tilt * 8 },
            {
              rotation: rest,
              duration: 1.3,
              ease: "power3.out",
              onComplete: startIdle,
            },
          );
          gsap.fromTo(
            chips,
            {
              rotation: (_index: number, target: Element) =>
                swingAngle(target, 14),
            },
            {
              rotation: 0,
              duration: 0.8,
              ease: "power2.out",
              stagger: { each: 0.06, from: "random" },
            },
          );
        };

        ScrollTrigger.create({
          trigger: card,
          start: "top 88%",
          onEnter: swing,
          onEnterBack: swing,
        });
      });

    gsap.from("#projects .project-extra", {
      autoAlpha: 0,
      y: 20,
      duration: 0.6,
      ease: "power2.out",
      scrollTrigger: {
        trigger: "#projects .project-extra",
        start: "top 95%",
        toggleActions: "play none none reverse",
      },
    });
  }
</script>
