---
const socials = [
  { label: "Email", href: "mailto:you@example.com" },
  { label: "LinkedIn", href: "https://linkedin.com/in/yourprofile" },
  { label: "GitHub", href: "https://github.com/yourprofile" },
  
];

const year = new Date().getFullYear();
---

<footer
  class="border-t border-dashed border-(--paper-line) bg-(--card-bg) px-8 py-10 shadow-sm"
>
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 md:flex-row"
  >
    <p class="font-caveat text-lg text-(--ink)">
      ChroNeo &middot; built with Astro, Tailwind &amp; GSAP
    </p>

    <div class="flex flex-wrap gap-2">
      {
        socials.map((social, i) => (
          <a
            href={social.href}
            class={`inline-block rounded border border-(--paper-line) bg-(--card-bg) px-3 py-1 text-sm text-(--ink) transition-colors hover:bg-(--paper-line) ${
              i % 2 === 0 ? "-rotate-1" : "rotate-1"
            }`}
          >
            {social.label}
          </a>
        ))
      }
    </div>
  </div>

  <p class="stamp mt-6 text-center text-xs text-(--ink-soft)/60">
    © {year} ChroNeo. all rights reserved.
  </p>
</footer>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reduceMotion) {
    gsap.from("footer > *", {
      autoAlpha: 0,
      y: 24,
      duration: 0.7,
      ease: "power3.out",
      stagger: 0.12,
      scrollTrigger: {
        trigger: "footer",
        start: "top 95%",
        toggleActions: "play none none reverse",
      },
    });
  }
</script>
