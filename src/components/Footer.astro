---
const socials = [
  { label: "Email", href: "mailto:you@example.com" },
  { label: "LinkedIn", href: "https://linkedin.com/in/yourprofile" },
  { label: "GitHub", href: "https://github.com/yourprofile" },
];

const year = new Date().getFullYear();
---

<footer
  class="px-8 py-10 border-t border-dashed border-amber-300 bg-amber-50/80 shadow-sm"
>
  <div
    class="flex flex-col md:flex-row justify-between items-center gap-4 max-w-5xl mx-auto"
  >
    <p class="font-caveat text-lg text-stone-700">
      ChroNeo &middot; built with Astro, Tailwind &amp; GSAP
    </p>

    <div class="flex gap-2 flex-wrap">
      {
        socials.map((social, i) => (
          <a
            href={social.href}
            class={`bg-white border border-amber-200 px-3 py-1 rounded text-sm text-stone-700 inline-block hover:bg-amber-50 transition-colors ${
              i % 2 === 0 ? "-rotate-1" : "rotate-1"
            }`}
          >
            {social.label}
          </a>
        ))
      }
    </div>
  </div>

  <p class="stamp text-xs text-amber-700/60 text-center mt-6">
    © {year} ChroNeo. all rights reserved.
  </p>
</footer>
