---
import { Image } from "astro:assets";
import portrait from "../assets/hero.png";
---

<section id="about" class="paper-bg px-8 py-20">
  <p class="mb-4 text-4xl font-bold text-(--ink)">ABOUT</p>

  <div class="grid grid-cols-1 items-start gap-8 md:grid-cols-[240px_1fr]">
    <!-- Portrait cutout -->
    <div class="about-portrait relative">
      <div class="tape -top-2 left-1/2 -translate-x-1/2 -rotate-3"></div>
      <div
        class="cut-1 -rotate-2 overflow-hidden border border-(--paper-line) bg-(--card-bg) p-1.5 shadow-md transition-transform duration-300 hover:scale-105"
      >
        <Image
          src={portrait}
          alt="ChroNeo portrait"
          width={300}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <!-- About card -->
    <div class="relative mt-2">
      <div class="tape -top-2 left-[60%] rotate-3"></div>
      <div
        class="rotate-1 border border-dashed border-(--paper-line) bg-(--card-bg) p-5 shadow-sm"
      >
        <h2 class="font-caveat mb-2 text-2xl font-semibold text-(--ink)">
          Hi, I'm Yongsak Saengsuk

        </h2>
        <p class="mb-3 text-base leading-relaxed text-(--ink-soft)">
          Fresh grad fullstack dev stepping into IT &amp; infra at a steel
          factory. Currently leveling up on cloud, networking, and AI-assisted
          dev workflows.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span
            class="inline-block -rotate-1 rounded bg-(--paper-line) px-2.5 py-0.5 text-sm text-(--ink)"
          >
            React
          </span>
          <span
            class="inline-block rotate-1 rounded bg-(--paper-line) px-2.5 py-0.5 text-sm text-(--ink)"
          >
            Astro
          </span>
          <span
            class="inline-block -rotate-2 rounded bg-(--paper-line) px-2.5 py-0.5 text-sm text-(--ink)"
          >
            Node.js
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const portrait = document.querySelector<HTMLElement>(".about-portrait");
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (portrait) {
    gsap.set(portrait, { transformOrigin: "50% 0%" });

    if (!reduceMotion) {
      const startIdle = () => {
        gsap.killTweensOf(portrait, "rotation");
        gsap.to(portrait, {
          rotation: 1.2,
          duration: 1.3,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
        });
      };

      const swing = () => {
        gsap.killTweensOf(portrait, "rotation");
        gsap.fromTo(
          portrait,
          { rotation: 8 },
          {
            rotation: 0,
            duration: 1.3,
            ease: "power3.out",
            onComplete: startIdle,
          },
        );
      };

      ScrollTrigger.create({
        trigger: portrait,
        start: "top 85%",
        onEnter: swing,
        onEnterBack: swing,
      });
    }
  }

  const label = document.querySelector("#about > p");
  if (label) {
    gsap.from(label, {
      autoAlpha: 0,
      y: 40,
      duration: 0.7,
      ease: "power3.out",
      scrollTrigger: {
        trigger: "#about",
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
    });
  }

  gsap.from("#about .grid > *", {
    autoAlpha: 0,
    y: 60,
    duration: 0.8,
    ease: "power3.out",
    stagger: 0.15,
    scrollTrigger: {
      trigger: "#about",
      start: "top 80%",
      toggleActions: "play none none reverse",
    },
  });
</script>
