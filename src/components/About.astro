---
import { Image } from "astro:assets";
import portrait from "../assets/hero.png";
---

<section id="about" class="paper-bg px-8 py-20">
  <p class="text-4xl font-bold text-black mb-4">ABOUT</p>

  <div class="grid grid-cols-1 md:grid-cols-[240px_1fr] gap-8 items-start">
    <!-- Portrait cutout -->
    <div class="relative">
      <div class="tape -top-2 left-1/2 -translate-x-1/2 -rotate-3"></div>
      <div
        class="cut-1 bg-amber-50 border border-amber-200 shadow-md -rotate-2 p-1.5 overflow-hidden"
      >
        <Image
          src={portrait}
          alt="ChroNeo portrait"
          width={300}
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- About card -->
    <div class="relative mt-2">
      <div class="tape -top-2 left-[60%] rotate-3"></div>
      <div
        class="bg-amber-50/80 border border-dashed border-amber-300 shadow-sm rotate-1 p-5"
      >
        <h2 class="font-caveat text-2xl font-semibold text-stone-800 mb-2">
          Hi, I'm ChroNeo
        </h2>
        <p class="text-stone-600 text-base leading-relaxed mb-3">
          Fresh grad fullstack dev stepping into IT &amp; infra at a steel
          factory. Currently leveling up on cloud, networking, and AI-assisted
          dev workflows.
        </p>
        <div class="flex gap-1.5 flex-wrap">
          <span
            class="bg-green-200 text-green-900 px-2.5 py-0.5 rounded text-sm -rotate-1 inline-block"
          >
            React
          </span>
          <span
            class="bg-green-200 text-green-900 px-2.5 py-0.5 rounded text-sm rotate-1 inline-block"
          >
            Astro
          </span>
          <span
            class="bg-green-200 text-green-900 px-2.5 py-0.5 rounded text-sm -rotate-2 inline-block"
          >
            Node.js
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
