---
interface Props {
  name: string;
  reason: string;
}
const { name, reason } = Astro.props;
---

<div
  class="my-3 border border-dashed border-amber-300 bg-amber-50 p-3"
>
  <span class="font-semibold text-stone-800">{name}</span>
  <span class="text-sm text-stone-600"> — {reason}</span>
</div>
