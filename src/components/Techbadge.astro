---
interface Props {
  name: string;
  reason: string;
}
const { name, reason } = Astro.props;
---

<div class="my-3 border border-dashed border-(--paper-line) bg-(--card-bg) p-3">
  <span class="font-semibold text-(--ink)">{name}</span>
  <span class="text-sm text-(--ink-soft)"> — {reason}</span>
</div>
