---
interface Props {
  name: string;
  reason: string;
}
const { name, reason } = Astro.props;
---

<div
  class="bg-amber-50 border border-dashed border-amber-300 p-3 my-3"
>
  <span class="font-semibold text-stone-800">{name}</span>
  <span class="text-stone-600 text-sm"> — {reason}</span>
</div>
