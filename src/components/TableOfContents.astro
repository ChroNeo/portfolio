---
interface Props {
  headings: Array<{ depth: number; text: string; slug: string }>;
}
const { headings } = Astro.props;
---

<!-- Mobile/Tablet Floating TOC Button -->
<button
  id="toc-toggle"
  class="lg:hidden fixed top-4 right-4 z-50 flex items-center gap-2 rounded-full border border-(--paper-line) bg-(--card-bg)/90 backdrop-blur-sm px-4 py-2 text-sm font-medium text-(--ink) shadow-md hover:bg-(--paper-line) transition-colors"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <line x1="3" y1="6" x2="21" y2="6"></line>
    <line x1="3" y1="12" x2="21" y2="12"></line>
    <line x1="3" y1="18" x2="21" y2="18"></line>
  </svg>
  On this page
</button>

<!-- Mobile/Tablet Dropdown TOC -->
<div
  id="toc-dropdown"
  class="lg:hidden fixed top-16 right-4 z-40 hidden w-72 bg-(--card-bg)/95 backdrop-blur-sm p-2"
>
  <nav>
    <h3
      class="mb-3 text-xs font-semibold uppercase tracking-wide text-(--ink-soft)"
    >
      On this page
    </h3>
    <ul class="space-y-1 text-sm">
      {
        headings.map((heading) => (
          <li
            id={`toc-${heading.slug}`}
            class={`toc-item rounded-r border-l-2 border-transparent text-(--ink-soft) transition-colors duration-200 hover:text-(--ink) hover:bg-(--paper-line) ${
              heading.depth > 2 ? "pl-6" : "pl-3"
            }`}
          >
            <a href={`#${heading.slug}`} class="block py-1 pr-2">
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<!-- Desktop Sidebar TOC -->
<aside class="sticky top-8 hidden h-fit w-64 shrink-0 lg:block">
  <nav>
    <h3
      class="mb-3 text-xs font-semibold uppercase tracking-wide text-(--ink-soft)"
    >
      On this page
    </h3>
    <ul class="space-y-1 text-sm">
      {
        headings.map((heading) => (
          <li
            id={`toc-${heading.slug}`}
            class={`toc-item rounded-r border-l-2 border-transparent text-(--ink-soft) transition-colors duration-200 hover:text-(--ink) hover:bg-(--paper-line) ${
              heading.depth > 2 ? "pl-6" : "pl-3"
            }`}
          >
            <a href={`#${heading.slug}`} class="block py-1 pr-2">
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<script>
  // Mobile TOC Toggle
  const tocToggle = document.getElementById("toc-toggle");
  const tocDropdown = document.getElementById("toc-dropdown");
  let isDropdownOpen = false;

  if (tocToggle && tocDropdown) {
    tocToggle.addEventListener("click", () => {
      isDropdownOpen = !isDropdownOpen;
      tocDropdown.classList.toggle("hidden", !isDropdownOpen);
    });

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
      if (
        isDropdownOpen &&
        !tocToggle.contains(e.target as Node) &&
        !tocDropdown.contains(e.target as Node)
      ) {
        isDropdownOpen = false;
        tocDropdown.classList.add("hidden");
      }
    });

    // Close dropdown when clicking a link
    tocDropdown.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        isDropdownOpen = false;
        tocDropdown.classList.add("hidden");
      });
    });
  }

  let isClickNavigation = false;

  const ACTIVE_CLASSES = ["border-(--ink)", "text-(--ink)", "font-medium"];
  const INACTIVE_CLASSES = ["border-transparent", "text-(--ink-soft)"];

  const setActive = (tocItem: Element) => {
    document.querySelectorAll(".toc-item").forEach((item) => {
      item.classList.remove(...ACTIVE_CLASSES);
      item.classList.add(...INACTIVE_CLASSES);
    });
    tocItem.classList.remove(...INACTIVE_CLASSES);
    tocItem.classList.add(...ACTIVE_CLASSES);
  };

  const observerOptions = {
    root: null,
    rootMargin: "-20% 0px -70% 0px",
    threshold: 0,
  };

  const headingEls = Array.from(
    document.querySelectorAll("h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]"),
  ) as HTMLElement[];

  // Figure out which heading should be active right now, on initial load,
  // since IntersectionObserver only reports *changes* going forward.
  const setInitialActive = () => {
    if (headingEls.length === 0) return;
    const thresholdLine = window.innerHeight * 0.2; // matches rootMargin top offset below
    let current = headingEls[0];
    for (const h of headingEls) {
      if (h.getBoundingClientRect().top <= thresholdLine) {
        current = h;
      } else {
        break;
      }
    }
    const tocItem = document.getElementById(`toc-${current.id}`);
    if (tocItem) setActive(tocItem);
  };
  setInitialActive();

  const observer = new IntersectionObserver((entries) => {
    if (isClickNavigation) return;
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        const tocItem = document.getElementById(`toc-${id}`);
        if (tocItem) setActive(tocItem);
      }
    });
  }, observerOptions);

  headingEls.forEach((heading) => {
    observer.observe(heading);
  });

  // Handle click events to manually highlight the selected item
  const nav = document.querySelector("aside nav");
  let scrollEndTimeout: ReturnType<typeof setTimeout> | null = null;
  const clearClickNavigation = () => {
    isClickNavigation = false;
    if (scrollEndTimeout) {
      clearTimeout(scrollEndTimeout);
      scrollEndTimeout = null;
    }
  };

  // Primary: native scrollend event (fires once scrolling truly stops)
  window.addEventListener("scrollend", () => {
    if (isClickNavigation) clearClickNavigation();
  });

  // Fallback for browsers without scrollend (older Safari): debounce scroll
  let scrollDebounce: ReturnType<typeof setTimeout> | null = null;
  window.addEventListener("scroll", () => {
    if (!isClickNavigation) return;
    if (scrollDebounce) clearTimeout(scrollDebounce);
    scrollDebounce = setTimeout(() => {
      clearClickNavigation();
    }, 150); // no scroll movement for 150ms = settled
  });

  // Absolute safety net in case neither fires (e.g. click didn't scroll at all)
  const armSafetyNet = () => {
    if (scrollEndTimeout) clearTimeout(scrollEndTimeout);
    scrollEndTimeout = setTimeout(clearClickNavigation, 3000);
  };

  if (nav) {
    nav.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const link = target.closest("a");
      if (link) {
        const href = link.getAttribute("href");
        if (href && href.startsWith("#")) {
          const slug = href.substring(1);
          const tocItem = document.getElementById(`toc-${slug}`);
          if (tocItem) {
            isClickNavigation = true;
            setActive(tocItem);
            armSafetyNet();
          }
        }
      }
    });
  }
</script>
