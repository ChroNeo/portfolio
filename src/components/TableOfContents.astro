---
interface Props {
  headings: Array<{ depth: number; text: string; slug: string }>;
}
const { headings } = Astro.props;
---

<aside class="sticky top-8 hidden h-fit w-64 shrink-0 lg:block">
  <nav class="border-l-2 border-amber-200 pl-4">
    <h3 class="mb-3 font-semibold text-stone-800">Contents</h3>
    <ul class="space-y-2 text-sm">
      {headings.map((heading) => (
        <li
          id={`toc-${heading.slug}`}
          class={`toc-item -mx-2 rounded px-2 text-stone-600 transition-colors duration-200 hover:text-stone-900 ${
            heading.depth > 2 ? 'pl-4' : ''
          }`}
        >
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  const observerOptions = {
    root: null,
    rootMargin: '-20% 0px -70% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        const tocItem = document.getElementById(`toc-${id}`);
        if (tocItem) {
          document.querySelectorAll('.toc-item').forEach(item => {
            item.classList.remove('bg-amber-100', 'text-stone-900', 'font-medium');
          });
          tocItem.classList.add('bg-amber-100', 'text-stone-900', 'font-medium');
        }
      }
    });
  }, observerOptions);

  document.querySelectorAll('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]').forEach(heading => {
    observer.observe(heading);
  });
</script>
