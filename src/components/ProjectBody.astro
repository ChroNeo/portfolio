---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ProjectBodyBlock, StrapiMedia } from "../lib/strapiBlocks";
import BenchmarkChart from "./BenchmarkChart.astro";
import Callout from "./Callout.astro";
import CmsTable from "./CmsTable.astro";
import FlowDiagram from "./FlowDiagram.astro";
import GalleryBox from "./GalleryBox.astro";
import ProjectGlance from "./ProjectGlance.astro";
import Techbadge from "./Techbadge.astro";

interface Props {
  blocks?: ProjectBodyBlock[] | null;
}

const { blocks } = Astro.props;

// The CMS returns null for an empty dynamic zone, and the prop is optional.
const items = blocks ?? [];

/**
 * Every image `cms:sync` has downloaded into the repo, so the body can point at
 * a real asset and Astro optimises it. Importing eagerly is fine: these are
 * project screenshots that live in the repo either way.
 */
const ASSETS = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/projects/**/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true },
);

const resolveMedia = (media?: StrapiMedia | null): ImageMetadata | undefined => {
  if (!media?.localPath) {
    return undefined;
  }
  return ASSETS[`/${media.localPath}`]?.default;
};
---

{
  items.map((block) => {
    switch (block.__component) {
      case "blocks.rich-text":
        return <Fragment set:html={block.html ?? ""} />;

      case "blocks.callout":
        return (
          <Callout type={block.type ?? "info"}>
            <Fragment set:html={block.bodyHtml ?? ""} />
          </Callout>
        );

      case "blocks.data-table":
        return (
          <CmsTable
            caption={block.caption ?? undefined}
            headers={block.headers ?? []}
            rows={block.rows ?? []}
          />
        );

      case "blocks.image": {
        const src = resolveMedia(block.image);
        if (src === undefined) {
          console.warn(
            `ProjectBody: no downloaded file for image "${block.image?.url ?? "unknown"}" — run \`npm run cms:sync\`.`,
          );
          return null;
        }
        return (
          <figure class={`mx-auto my-8 ${block.wide ? "max-w-4xl" : "max-w-2xl"}`}>
            <Image
              src={src}
              alt={block.image?.alternativeText ?? ""}
              loading="lazy"
              decoding="async"
              class="h-auto w-full rounded-xl border border-(--paper-line) shadow-md"
            />
            {block.caption && (
              <figcaption class="mt-2 text-center text-sm text-(--ink-soft)">
                {block.caption}
              </figcaption>
            )}
          </figure>
        );
      }

      case "blocks.gallery": {
        const images = (block.images ?? [])
          .map((image) => ({ src: resolveMedia(image), image }))
          .filter((item): item is { src: ImageMetadata; image: StrapiMedia } => item.src !== undefined);

        if (images.length < (block.images ?? []).length) {
          console.warn(`ProjectBody: gallery "${block.title ?? ""}" is missing a downloaded file.`);
        }

        return (
          <GalleryBox
            title={block.title ?? undefined}
            items={images.map(({ src, image }) => ({
              src,
              alt: image.alternativeText ?? "",
              caption: image.caption ?? undefined,
            }))}
          />
        );
      }

      case "blocks.benchmark":
        return (
          <BenchmarkChart
            source={block.source ?? undefined}
            sourceUrl={block.sourceUrl ?? undefined}
            dataUpdatedAt={block.dataUpdatedAt ?? undefined}
            benchmarks={(block.datasets ?? []).map((dataset) => ({
              label: dataset.label ?? "",
              unit: dataset.unit ?? "",
              note: dataset.note ?? "",
              bars: (dataset.bars ?? []).map((bar) => ({
                name: bar.name ?? "",
                value: typeof bar.value === "string" ? Number(bar.value) : (bar.value ?? 0),
                version: bar.version ?? "",
              })),
            }))}
          />
        );

      case "blocks.flow-diagram":
        return (
          <FlowDiagram
            label={block.label ?? undefined}
            steps={(block.steps ?? []).map((step) => ({
              label: step.label ?? "",
              note: step.note ?? undefined,
            }))}
          />
        );

      case "blocks.project-glance":
        return (
          <ProjectGlance
            title={block.title ?? undefined}
            items={(block.items ?? []).map((item) => ({
              label: item.label ?? "",
              value: item.value ?? "",
            }))}
            stack={block.stack ?? undefined}
          />
        );

      case "blocks.tech-badge":
        return <Techbadge name={block.name ?? ""} reason={block.reason ?? ""} />;

      default:
        return null;
    }
  })
}
