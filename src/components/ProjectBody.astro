---
import { Image } from "astro:assets";
import type { ProjectBodyBlock, StrapiMedia } from "../lib/strapiBlocks";
import { mediaUrl } from "../lib/strapi";
import BenchmarkChart from "./BenchmarkChart.astro";
import Callout from "./Callout.astro";
import CmsTable from "./CmsTable.astro";
import FlowDiagram from "./FlowDiagram.astro";
import GalleryBox from "./GalleryBox.astro";
import ProjectGlance from "./ProjectGlance.astro";
import Techbadge from "./Techbadge.astro";

interface Props {
  blocks?: ProjectBodyBlock[] | null;
}

const { blocks } = Astro.props;

// The CMS returns null for an empty dynamic zone, and the prop is optional.
const items = blocks ?? [];

/**
 * A CMS image, resolved to something `<Image>` can optimise at build time.
 *
 * Strapi reports `width`/`height` for every upload; the fallback keeps a build
 * from failing on an image whose dimensions it never recorded.
 */
const resolveMedia = (
  media?: StrapiMedia | null,
): { src: string; width: number; height: number } | undefined => {
  if (!media?.url) {
    return undefined;
  }
  const width = media.width ?? 1600;
  const height = media.height ?? Math.round((width * 9) / 16);
  return { src: mediaUrl(media.url), width, height };
};
---

{
  items.map((block) => {
    switch (block.__component) {
      case "blocks.rich-text":
        return <Fragment set:html={block.html ?? ""} />;

      case "blocks.callout":
        return (
          <Callout type={block.type ?? "info"}>
            <Fragment set:html={block.bodyHtml ?? ""} />
          </Callout>
        );

      case "blocks.data-table":
        return (
          <CmsTable
            caption={block.caption ?? undefined}
            headers={block.headers ?? []}
            rows={block.rows ?? []}
          />
        );

      case "blocks.image": {
        const src = resolveMedia(block.image);
        if (src === undefined) {
          console.warn(
            `ProjectBody: image block "${block.caption ?? block.__component}" has no media — check the CMS entry.`,
          );
          return null;
        }
        return (
          <figure class={`mx-auto my-8 ${block.wide ? "max-w-4xl" : "max-w-2xl"}`}>
            <Image
              src={src.src}
              width={src.width}
              height={src.height}
              alt={block.image?.alternativeText ?? ""}
              loading="lazy"
              decoding="async"
              class="h-auto w-full rounded-xl border border-(--paper-line) shadow-md"
            />
            {block.caption && (
              <figcaption class="mt-2 text-center text-sm text-(--ink-soft)">
                {block.caption}
              </figcaption>
            )}
          </figure>
        );
      }

      case "blocks.gallery": {
        const images: { media: { src: string; width: number; height: number }; image: StrapiMedia }[] = [];
        for (const image of block.images ?? []) {
          const media = resolveMedia(image);
          if (media !== undefined) {
            images.push({ media, image });
          }
        }

        if (images.length < (block.images ?? []).length) {
          console.warn(`ProjectBody: gallery "${block.title ?? ""}" is missing a media file.`);
        }

        return (
          <GalleryBox
            title={block.title ?? undefined}
            items={images.map(({ media, image }) => ({
              src: media.src,
              alt: image.alternativeText ?? "",
              caption: image.caption ?? undefined,
            }))}
          />
        );
      }

      case "blocks.benchmark": {
        const datasets = (block.datasets ?? []).map((dataset) => ({
          label: dataset.label ?? "",
          unit: dataset.unit ?? "",
          note: dataset.note ?? "",
          bars: (dataset.bars ?? []).map((bar) => ({
            name: bar.name ?? "",
            value: typeof bar.value === "string" ? Number(bar.value) : (bar.value ?? 0),
            version: bar.version ?? "",
          })),
        }));

        // An empty array would defeat the component's own defaults - and it
        // cannot render zero datasets - so the prop is left off instead.
        return (
          <BenchmarkChart
            source={block.source ?? undefined}
            sourceUrl={block.sourceUrl ?? undefined}
            dataUpdatedAt={block.dataUpdatedAt ?? undefined}
            benchmarks={datasets.length > 0 ? datasets : undefined}
          />
        );
      }

      case "blocks.flow-diagram":
        return (
          <FlowDiagram
            label={block.label ?? undefined}
            steps={(block.steps ?? []).map((step) => ({
              label: step.label ?? "",
              note: step.note ?? undefined,
            }))}
          />
        );

      case "blocks.project-glance":
        return (
          <ProjectGlance
            title={block.title ?? undefined}
            items={(block.items ?? []).map((item) => ({
              label: item.label ?? "",
              value: item.value ?? "",
            }))}
            stack={block.stack ?? undefined}
          />
        );

      case "blocks.tech-badge":
        return <Techbadge name={block.name ?? ""} reason={block.reason ?? ""} />;

      default:
        return null;
    }
  })
}
