---
// Hero.astro
---

<section
  id="hero"
  class="flex min-h-screen flex-row items-center justify-center px-8"
>
  <div
    class="cut-2 h-1/2 rotate-1 border border-(--paper-line) bg-(--card-bg) p-12 shadow-2xl"
  >
    <h1 class="hero-title text-6xl font-bold opacity-0 text-(--ink)">
      Hi, I'm Neo
    </h1>
    <p class="hero-sub mt-4 text-center text-xl text-(--ink-soft) opacity-0">
      Welcome to my portfolio.
    </p>
  </div>

  <div
    class="hero-img ml-10 flex translate-y-10 transform items-center justify-center opacity-0 drop-shadow-lg transition-transform duration-300 hover:translate-y-0"
  >
  </div>
</section>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    gsap
      .timeline()
      .to(
        ".hero-title",
        {
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: "power3.out",
        },
        0,
      )
      .to(
        ".hero-img",
        { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" },
        0,
      )
      .to(
        ".hero-sub",
        { opacity: 1, y: 0, duration: 0.6, ease: "power3.out" },
        "-=0.4",
      );
  });
</script>
