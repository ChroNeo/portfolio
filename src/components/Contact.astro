---
const socials = [
  { label: "Email", href: "mailto:you@example.com" },
  { label: "LinkedIn", href: "https://linkedin.com/in/yourprofile" },
  { label: "GitHub", href: "https://github.com/yourprofile" },
];
---

<section id="contact" class="paper-bg px-8 py-20">
  <p class="mb-4 text-4xl font-bold text-black">CONTACT</p>

  <div class="relative">
    <div class="tape -top-2 left-[30%] -rotate-3"></div>
    <div class="tape -top-2 left-[70%] rotate-3"></div>

    <div
      class="flex rotate-[0.5deg] flex-col items-start justify-between gap-4 border border-dashed border-amber-300 bg-amber-50/80 p-6 shadow-sm md:flex-row md:items-center"
    >
      <div>
        <h2 class="font-caveat mb-1 text-2xl font-semibold text-stone-800">
          Let's talk
        </h2>
        <p class="text-base text-stone-600">
          Open to junior dev &amp; IT roles
        </p>
      </div>

      <div class="flex flex-wrap gap-2">
        {
          socials.map((social, i) => (
            <a
              href={social.href}
              class={`inline-block rounded border border-amber-200 bg-white px-3 py-1.5 text-sm text-stone-700 transition-colors hover:bg-amber-50 ${
                i % 2 === 0 ? "-rotate-1" : "rotate-1"
              }`}
            >
              {social.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>
