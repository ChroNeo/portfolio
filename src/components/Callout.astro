---
interface Props {
  type?: "info" | "warning" | "success";
}
const { type = "info" } = Astro.props;

const styles = {
  info: "bg-(--paper-line) border-(--paper-line) text-(--ink)",
  warning: "bg-(--paper-line) border-(--paper-line) text-(--ink)",
  success: "bg-(--paper-line) border-(--paper-line) text-(--ink)",
};

const icons = {
  info: "💡",
  warning: "⚠️",
  success: "✅",
};
---

<div class={`border border-dashed ${styles[type]} my-4 p-4 `}>
  <p class="text-sm leading-relaxed">
    <span class="mr-1.5">{icons[type]}</span>
    <slot />
  </p>
</div>
