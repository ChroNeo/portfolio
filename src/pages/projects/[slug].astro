---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import TableOfContents from "../../components/TableOfContents.astro";
import "../../styles/project.css";
import {
  SiReact,
  SiTypescript,
  SiJavascript,
  SiFastify,
  SiNodedotjs,
  SiMysql,
  SiDocker,
  SiLinux,
  SiGooglecloud,
  SiSocketdotio,
  SiRedis,
  SiPostgresql,
} from "react-icons/si";
import { FaAws, FaLine } from "react-icons/fa6";
import type { IconType } from "react-icons/lib";
import { FiArrowLeft } from "react-icons/fi";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

// Icon mapping for common tech
const getTechIcon = (tech: string) => {
  const icons: Record<string, IconType> = {
    React: SiReact,
    TypeScript: SiTypescript,
    JavaScript: SiJavascript,
    Fastify: SiFastify,
    "Node.js": SiNodedotjs,
    MySQL: SiMysql,
    Docker: SiDocker,
    Linux: SiLinux,
    AWS: FaAws,
    GCP: SiGooglecloud,
    "Socket.io": SiSocketdotio,
    Redis: SiRedis,
    PostgreSQL: SiPostgresql,
    LINE: FaLine,
    "LINE Messaging API": FaLine,
  };
  return icons[tech] || SiJavascript;
};
---

<BaseLayout title={`${project.data.title} | ChroNeo`}>
  <div class="mx-auto flex max-w-6xl gap-8 px-8 py-16">
    <article class="paper-bg flex-1 px-8 py-16">
      <a
        href="/portfolio/#projects"
        class="group inline-flex items-center gap-1.5 text-sm font-medium text-amber-700 transition-colors hover:text-amber-900"
      >
        <FiArrowLeft
          className="h-4 w-4 transition-transform group-hover:-translate-x-0.5"
        />
        Back to projects
      </a>

      <h1 class="font-caveat mt-4 mb-2 text-4xl font-semibold text-stone-800">
        {project.data.title}
      </h1>
      <p class="mb-4 text-lg text-stone-600">{project.data.description}</p>

      {
        project.data.thumbnail && (
          <div class="cut-1 mb-6 max-w-md -rotate-1 overflow-hidden border border-amber-200 bg-amber-50 shadow-md">
            <Image
              src={project.data.thumbnail}
              alt={project.data.title}
              width={600}
              class="h-auto w-full object-cover"
            />
          </div>
        )
      }

      <div class="mb-6 flex flex-wrap gap-2">
        {
          project.data.stack.map((tech) => {
            const Icon = getTechIcon(tech);
            return (
              <span class="inline-flex items-center gap-1 rounded bg-amber-100/50 px-4 py-2 text-base text-stone-500">
                <Icon size={16} />
                <span>{tech}</span>
              </span>
            );
          })
        }
      </div>

      <div class="mb-10 flex gap-3">
        {
          project.data.demo && (
            <a
              href={project.data.demo}
              class="inline-block -rotate-1 rounded border border-amber-200 bg-white px-3 py-1.5 text-sm text-stone-700"
            >
              Live demo
            </a>
          )
        }
        {
          project.data.github && (
            <a
              href={project.data.github}
              class="inline-block rotate-1 rounded border border-amber-200 bg-white px-3 py-1.5 text-sm text-stone-700"
            >
              GitHub
            </a>
          )
        }
      </div>

      <div
        class="prose prose-stone prose-h2:text-3xl prose-h2:font-semibold prose-h2:text-stone-800 prose-h2:mt-8 prose-h2:mb-4 max-w-none text-stone-700"
      >
        <Content />
      </div>
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
