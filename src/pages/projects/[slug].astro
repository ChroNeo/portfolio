---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import TableOfContents from "../../components/TableOfContents.astro";
import "../../styles/project.css";
import { FiArrowLeft } from "react-icons/fi";
import { FaGithub, FaArrowUpRightFromSquare } from "react-icons/fa6";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
---

<BaseLayout
  title={`${project.data.title}${project.data.titleEn ? ` / ${project.data.titleEn}` : ""} | ChroNeo`}
>
  <a
    href="/portfolio/#projects"
    aria-label="Back to projects"
    class="group fixed top-4 left-4 z-50 inline-flex h-10 w-10 items-center justify-center rounded-full bg-(--card-bg)/90 text-(--ink) shadow-md backdrop-blur-sm transition-colors hover:bg-(--paper-line) hover:text-(--ink-soft)"
  >
    <FiArrowLeft
      className="h-5 w-5 transition-transform group-hover:-translate-x-0.5"
    />
  </a>

  <div class="mx-auto flex max-w-6xl gap-8 px-4 pt-8 pb-16">
    <article class="paper-bg flex-1 px-4 pt-8 pb-16 sm:px-8">
      <div class="mx-auto mt-2 mb-10 max-w-5xl text-center">
        <div class="swing-in mb-4 flex items-center justify-center gap-3 text-sm opacity-0">
          <span
            class="rounded-full bg-lime-100 px-3 py-1 font-medium text-lime-800"
          >
            {project.data.category ?? "Project"}
          </span>
          <span class="text-stone-400">
            {
              project.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </span>
        </div>

        <h1
          class="swing-in font-caveat mb-2 text-4xl leading-tight font-semibold text-(--ink) opacity-0 sm:text-5xl sm:whitespace-nowrap"
        >
          {project.data.title}
        </h1>

        {
          project.data.titleEn && (
            <p class="swing-in font-caveat mb-4 text-xl font-medium text-(--ink) opacity-0 sm:text-2xl">
              {project.data.titleEn}
            </p>
          )
        }

        <p class="swing-in mx-auto max-w-2xl text-lg text-(--ink-soft) opacity-0">
          {project.data.description}
        </p>
      </div>

      {
        project.data.thumbnail && (
          <div class="project-image mx-auto mb-10 max-w-2xl overflow-hidden rounded-2xl border border-(--paper-line) shadow-md">
            <Image
              src={project.data.thumbnail}
              alt={project.data.title}
              width={1200}
              class="h-auto w-full object-cover"
            />
          </div>
        )
      }

      <div class="swing-in mb-10 flex justify-center gap-3 opacity-0">
        {
          project.data.demo && (
            <a
              href={project.data.demo}
              class="inline-flex -rotate-1 items-center gap-2 rounded-md border border-(--paper-line) bg-(--card-bg) px-4 py-1.5 text-sm text-(--ink) shadow-sm transition-transform duration-200 hover:rotate-0"
            >
              <FaArrowUpRightFromSquare size={14} />
              Live demo
            </a>
          )
        }
        {
          project.data.github && (
            <a
              href={project.data.github}
              class="inline-flex rotate-1 items-center gap-2 rounded-md border border-(--paper-line) bg-(--card-bg) px-4 py-1.5 text-sm text-(--ink) shadow-sm transition-transform duration-200 hover:rotate-0"
            >
              <FaGithub size={14} />
              GitHub
            </a>
          )
        }
      </div>

      <div
        class="prose prose-stone prose-h2:text-3xl prose-h2:font-semibold prose-h2:mt-8 prose-h2:mb-4 max-w-none text-(--ink-soft) [--tw-prose-headings:var(--ink)]"
      >
        <Content />
      </div>
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const topItems = gsap.utils.toArray<HTMLElement>(".swing-in");

  if (reduceMotion) {
    gsap.set(topItems, { opacity: 1 });
  } else {
    gsap.set(topItems, { transformOrigin: "50% 0%" });
    gsap.fromTo(
      topItems,
      {
        autoAlpha: 0,
        y: -24,
        rotation: (index) => (index % 2 === 0 ? -6 : 6),
      },
      {
        autoAlpha: 1,
        y: 0,
        rotation: 0,
        duration: 1.2,
        ease: "elastic.out(1, 0.45)",
        stagger: 0.1,
      },
    );
  }

  const images = gsap.utils.toArray<HTMLElement>(
    ".project-image, .prose img",
  );

  images.forEach((image) => {
    gsap.from(image, {
      autoAlpha: 0,
      scale: 0.7,
      duration: 0.4,
      ease: "back.inOut(1.7)",
      scrollTrigger: {
        trigger: image,
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
    });
  });

  ScrollTrigger.refresh();
</script>
