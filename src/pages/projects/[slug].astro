---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import TableOfContents from "../../components/TableOfContents.astro";
import "../../styles/project.css";
import {
  SiReact,
  SiTypescript,
  SiJavascript,
  SiFastify,
  SiNodedotjs,
  SiMysql,
  SiDocker,
  SiLinux,
  SiGooglecloud,
  SiSocketdotio,
  SiRedis,
  SiPostgresql,
} from "react-icons/si";
import { FaAws, FaLine } from "react-icons/fa6";
import type { IconType } from "react-icons/lib";
import { FiArrowLeft } from "react-icons/fi";

export async function getStaticPaths() {
  const projects = (await getCollection("projects")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);

// Icon mapping for common tech
const getTechIcon = (tech: string) => {
  const icons: Record<string, IconType> = {
    React: SiReact,
    TypeScript: SiTypescript,
    JavaScript: SiJavascript,
    Fastify: SiFastify,
    "Node.js": SiNodedotjs,
    MySQL: SiMysql,
    Docker: SiDocker,
    Linux: SiLinux,
    AWS: FaAws,
    GCP: SiGooglecloud,
    "Socket.io": SiSocketdotio,
    Redis: SiRedis,
    PostgreSQL: SiPostgresql,
    LINE: FaLine,
    "LINE Messaging API": FaLine,
  };
  return icons[tech] || SiJavascript;
};
---

<BaseLayout title={`${project.data.title} | ChroNeo`}>
  <div class="mx-auto flex max-w-6xl gap-8 px-8 py-16">
    <article class="paper-bg flex-1 px-8 py-16">
      <a
        href="/portfolio/#projects"
        class="group inline-flex items-center gap-1.5 text-sm font-medium text-amber-700 transition-colors hover:text-amber-900"
      >
        <FiArrowLeft
          className="h-4 w-4 transition-transform group-hover:-translate-x-0.5"
        />
        Back to projects
      </a>

      <div class="mx-auto mt-6 mb-10 max-w-3xl text-center">
        <div class="mb-4 flex items-center justify-center gap-3 text-sm">
          <span
            class="rounded-full bg-lime-100 px-3 py-1 font-medium text-lime-800"
          >
            {project.data.category ?? "Project"}
          </span>
          <span class="text-stone-400">
            {
              project.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </span>
        </div>

        <h1
          class="font-caveat mb-4 text-4xl leading-tight font-semibold text-(--ink) sm:text-5xl"
        >
          {project.data.title}
        </h1>

        <p class="mx-auto max-w-2xl text-lg text-(--ink-soft)">
          {project.data.description}
        </p>
      </div>

      {
        project.data.thumbnail && (
          <div class="mb-10 max-w-2xl mx-auto overflow-hidden rounded-2xl border border-(--paper-line) shadow-md">
            <Image
              src={project.data.thumbnail}
              alt={project.data.title}
              width={1200}
              class="h-auto w-full object-cover"
            />
          </div>
        )
      }

      <div class="mb-6 flex flex-wrap gap-2">
        {
          project.data.stack.map((tech) => {
            const Icon = getTechIcon(tech);
            return (
              <span class="inline-flex items-center gap-1 rounded bg-(--card-bg) px-4 py-2 text-base text-(--ink)">
                <Icon size={16} />
                <span>{tech}</span>
              </span>
            );
          })
        }
      </div>

      <div class="mb-10 flex gap-3">
        {
          project.data.demo && (
            <a
              href={project.data.demo}
              class="inline-block -rotate-1 rounded border border-amber-200 bg-white px-3 py-1.5 text-sm text-stone-700"
            >
              Live demo
            </a>
          )
        }
        {
          project.data.github && (
            <a
              href={project.data.github}
              class="inline-block rotate-1 rounded border border-amber-200 bg-white px-3 py-1.5 text-sm text-stone-700"
            >
              GitHub
            </a>
          )
        }
      </div>

      <div
        class="prose prose-stone prose-h2:text-3xl prose-h2:font-semibold prose-h2:mt-8 prose-h2:mb-4 max-w-none text-(--ink-soft) [--tw-prose-headings:var(--ink)]"
      >
        <Content />
      </div>
    </article>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>
